NODE_ENV=development
PORT=3000
DATABASE_URL=mysql://note_app:note_app@localhost:3306/note_app
SESSION_SECRET=replace-with-a-long-random-development-secret
SESSION_COOKIE_NAME=note_app_session
CSRF_SECRET=replace-with-a-long-random-development-secret
AUTH_CODE_SECRET=replace-with-a-long-random-development-secret
CORS_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
ALLOW_CROSS_SITE_COOKIES=false
REQUIRE_SAME_ORIGIN_HEADERS=true
REQUEST_BODY_LIMIT=1mb
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
RATE_LIMIT_STORE=memory
BACKEND_INSTANCE_COUNT=1
TRUST_PROXY=false
SEED_EMAIL=dev@example.test
SEED_PASSWORD=replace-with-a-local-development-password
HOSTINGER_API_TOKEN=replace-with-your-hostinger-api-token
HOSTINGER_MAILBOX_RESOURCE_ID=replace-with-your-mailbox-resource-id
HOSTINGER_API_BASE_URL=https://api.mail.hostinger.com
MAIL_FROM=noreply@yourdomain.com
MAIL_FROM_NAME=Oqira
APP_URL=http://localhost:5173
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
FACEBOOK_CLIENT_ID=replace-with-facebook-client-id
FACEBOOK_CLIENT_SECRET=replace-with-facebook-client-secret
FACEBOOK_REDIRECT_URI=http://localhost:3000/api/v1/auth/facebook/callback
