{
  "name": "@note-app/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run",
    "test:api": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run test/api",
    "test:db": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run test/integration",
    "db:migrate": "node --env-file-if-exists=.env src/db/migrateCli.js up",
    "db:rollback": "node --env-file-if-exists=.env src/db/migrateCli.js down",
    "db:empty": "node --env-file-if-exists=.env src/db/emptyDatabaseCli.js",
    "db:seed": "node --env-file-if-exists=.env src/db/seed.js"
  },
  "dependencies": {
    "argon2": "^0.44.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "jose": "^6.2.12",
    "mysql2": "^3.11.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "eslint": "^9.35.0",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "vitest": "^3.2.4"
  }
}
