{
  "name": "note-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm run dev --workspace frontend\" \"npm run dev --workspace backend\"",
    "build": "npm run build --workspace frontend",
    "lint": "npm run lint --workspace frontend && npm run lint --workspace backend",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspace backend",
    "test:api": "npm run test:api --workspace backend",
    "test:e2e": "playwright test --pass-with-no-tests",
    "db:migrate": "node --env-file-if-exists=.env node_modules/node-pg-migrate/bin/node-pg-migrate.js --migrations-dir backend/migrations up",
    "db:rollback": "node --env-file-if-exists=.env node_modules/node-pg-migrate/bin/node-pg-migrate.js --migrations-dir backend/migrations down",
    "db:seed": "node --env-file-if-exists=.env backend/src/db/seed.js",
    "test:db": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run backend/test/integration"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "playwright": "^1.55.0",
    "prettier": "^3.6.2"
  }
}
